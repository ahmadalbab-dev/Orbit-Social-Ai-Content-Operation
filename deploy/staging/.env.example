# Copy to deploy/staging/.env. Use a random hexadecimal password (URL-safe).
STAGING_DB_PASSWORD=replace_with_random_hex_password
# Browser URLs on the Docker host only. Rebuild web after changing public values.
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Only a public publishable/anon key belongs here. Never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_JWT_ISSUER=https://your-project.supabase.co/auth/v1
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Server-only AI credential; leave empty to keep generation unavailable.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
AI_MONTHLY_GENERATION_LIMIT=100
# Keep false until codec isolation exists, or use trusted fixtures in private testing.
MEDIA_RENDER_ENABLED=false

# Server-only Stripe sandbox. Keep disabled until test prices and webhook exist.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_BUSINESS=
