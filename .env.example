NODE_ENV=development
AUTH_MODE=local-demo
# Local demo stays on loopback. Docker sets its internal bind separately.
API_BIND_HOST=127.0.0.1
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WORKSPACE_ID=demo-workspace
MYSHOP_URL=https://malaysia.4life.com/corp/shop/all
NEXT_PUBLIC_MYSHOP_LINK=http://localhost:3000/go/myshop
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_automation
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-nano
AI_MONTHLY_BUDGET_USD=10
AI_REQUEST_MAX_TOKENS=1200
TOKEN_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
N8N_WEBHOOK_URL=
SOCIAL_CONNECTOR_MODE=mock
# No live account OAuth or durable scheduler is enabled yet.
# Set the explicitly supported version before using low-level server adapters.
META_GRAPH_API_VERSION=
THREADS_API_VERSION=v1.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/v1/oauth/meta/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3001/v1/oauth/threads/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/v1/oauth/tiktok/callback
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
