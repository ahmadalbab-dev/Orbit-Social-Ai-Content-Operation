NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
MYSHOP_URL=https://malaysia.4life.com/corp/shop/all
NEXT_PUBLIC_MYSHOP_LINK=http://localhost:3000/go/myshop
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_automation
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-nano
AI_MONTHLY_BUDGET_USD=10
AI_REQUEST_MAX_TOKENS=1200
TOKEN_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
N8N_WEBHOOK_URL=
SOCIAL_CONNECTOR_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Pin a version supported by your Meta app; OAuth needs HTTPS WEB_URL callbacks.
META_API_VERSION=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/v1/oauth/tiktok/callback
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# Commercial identity: configure ONE trusted signing-key method on the API.
# Supabase current signing keys use AUTH_JWKS_URL; HS256 is legacy compatibility.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWKS_URL=
AUTH_JWT_SECRET=
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Platform-owned inference credentials. Never use NEXT_PUBLIC_ for these.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
AI_MONTHLY_GENERATION_LIMIT=100

# Private-volume media alpha. Create the directory outside public web paths.
# API and isolated worker share it. Leave disabled until that setup is ready.
MEDIA_RENDER_ENABLED=false
MEDIA_ROOT=

# Server-only Stripe sandbox. Keep disabled until test prices and webhook exist.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_BUSINESS=

# Optional isolated AI test routing; these do not activate billing or production.
AI_TEXT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Keep HF image editing unless an operator explicitly selects gemini for a test.
AI_IMAGE_PROVIDER=huggingface
